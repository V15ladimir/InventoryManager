@using InventoryManager.Models.Enums
@using InventoryManager.Models.ViewModels.Items
@model InventoryItemsViewModel

<div class="container-fluid">
    <div hx-target="#itemsContainer" hx-swap="innerHTML">
        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-sm">
                <p>All inventory items</p>
            </div>
            @if(Model.HasSuperAccess) {
                <div class="col-12 col-sm-auto">
                    <div class="btn-group" role="group">
                        <button class="btn btn-secondary"
                                hx-get="@Url.Action("Create", "Items", new {
                                    inventoryId = Model.InventoryId,
                                    page = Model.Items.PageIndex,
                                    pageSize = Model.Items.PageSize,
                                    sortBy = Model.Items.SortBy,
                                    sortOrder = Model.Items.SortOrder,
                                    searchText = Model.Items.SearchText
                                })"
                                hx-target="#itemsContainer"
                                hx-swap="innerHTML">
                            Create
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                hx-delete="@Url.Action("Delete", "Items", new { inventoryId = Model.InventoryId })"
                                hx-target="#itemsContainer"
                                hx-swap="innerHTML"
                                hx-vals='js:{itemIds: getSelectedIds()}'>
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </div>
                </div>
            }
            <div class="col-12 col-sm-auto">
                <input type="hidden" name="inventoryId" value="@Model.InventoryId" />
                <div class="input-group">
                    <input type="text" name="searchText" class="form-control border-secondary"
                        value="@Model.Items.SearchText" 
                        placeholder="Filter..."
                        hx-get="@Url.Action("Index", "Items")"
                        hx-target="#itemsContainer"
                        hx-swap="innerHTML"
                        hx-trigger="keyup changed delay:500ms"
                        hx-include="[name='inventoryId'], [name='pageSize'], [name='sortBy'], [name='sortOrder']" />
                    <button class="btn btn-secondary" 
                            hx-get="@Url.Action("Index", "Items")"
                            hx-target="#itemsContainer"
                            hx-swap="innerHTML"
                            hx-include="[name='inventoryId'], [name='searchText'], [name='pageSize'], [name='sortBy'], [name='sortOrder']">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        @{
            var inventorySortBy = Model.Items.SortBy;
            var inventorySortOrder = Model.Items.SortOrder;
            string ChangeSortOrder(string sortBy) => inventorySortBy == sortBy && inventorySortOrder == "asc" ? "desc" : "asc";
            string GetSortIcon(string sortBy) => inventorySortBy == sortBy ?
                (inventorySortOrder == "asc" ? "bi bi-chevron-up" : "bi bi-chevron-down") :
                "bi bi-chevron-expand";
        }
        <table class="table">
            <thead>
                <tr>
                    @if(Model.HasSuperAccess) {
                        <th scope="col" style="width: 40px;">
                            <input type="checkbox" class="form-check-input" id="selectAll">
                        </th>
                    }
                    <th scope="col">
                        <button type="button"
                                class="btn btn-link text-decoration-none text-dark p-0 m-0 fw-bold"
                                hx-get="@Url.Action("Index", "Items")"
                                hx-target="#itemsContainer"
                                hx-swap="innerHTML"
                                hx-include="[name='inventoryId'], [name='page'], [name='pageSize'], [name='searchText']"
                                hx-vals='js:{sortBy: "customid", sortOrder: "@ChangeSortOrder("customid")"}'>
                            CustomId
                            <i class="@(GetSortIcon("customid"))"></i>
                        </button>
                    </th>
                    @foreach(var header in Model.Fields) {
                        <th scope="col">
                            @header.Name
                        </th>
                    }
                    <th>
                        <button type="button"
                                class="btn btn-link text-decoration-none text-dark p-0 m-0 fw-bold"
                                hx-get="@Url.Action("Index", "Items")"
                                hx-target="#itemsContainer"
                                hx-swap="innerHTML"
                                hx-include="[name='inventoryId'], [name='page'], [name='pageSize'], [name='searchText']"
                                hx-vals='js:{sortBy: "created", sortOrder: "@ChangeSortOrder("created")"}'>
                            Created
                            <i class="@(GetSortIcon("created"))"></i>
                        </button>
                    </th>
                    <th>
                        <button type="button"
                                class="btn btn-link text-decoration-none text-dark p-0 m-0 fw-bold"
                                hx-get="@Url.Action("Index", "Items")"
                                hx-target="#itemsContainer"
                                hx-swap="innerHTML"
                                hx-include="[name='inventoryId'], [name='page'], [name='pageSize'], [name='searchText']"
                                hx-vals='js:{sortBy: "updated", sortOrder: "@ChangeSortOrder("updated")"}'>
                            Updated
                            <i class="@(GetSortIcon("updated"))"></i>
                        </button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if(Model.Items.Elements.Any()) {
                    @foreach(var item in Model.Items.Elements) {
                        <tr>
                            @if(Model.HasSuperAccess) {
                                <td>
                                    <input type="checkbox" class="form-check-input item-select" value="@item.Id">
                                </td>
                            }
                            <td>
                                @if(Model.HasSuperAccess){
                                    <a href="#"
                                        class="text-decoration-none"
                                        hx-get="@Url.Action("Edit", "Items", new {
                                            itemId = item.Id,
                                            page = Model.Items.PageIndex,
                                            pageSize = Model.Items.PageSize,
                                            sortBy = Model.Items.SortBy,
                                            sortOrder = Model.Items.SortOrder,
                                            searchText = Model.Items.SearchText
                                        })"
                                        hx-target="#itemsContainer"
                                        hx-swap="innerHTML">
                                        @item.CustomId
                                    </a>
                                } else {
                                    @item.CustomId
                                }
                            </td>
                            @foreach(var field in Model.Fields) {
                                var value = item.ItemValues.FirstOrDefault(v => v.FieldId == field.Id);
                                var displayValue = value?.Value ?? "-";
                                <td>
                                    @if(field.Type == FieldType.Link && !string.IsNullOrWhiteSpace(value?.Value)) {
                                        <a href="@value.Value" target="_blank">@value.Value</a>
                                    } else {
                                        @displayValue
                                    }
                                </td>
                            }
                            <td>
                                @item.CreatedAt
                            </td>
                            <td>
                                @item.UpdatedAt
                            </td>
                        </tr>
                    }
                } else {
                    var colspan = Model.Fields.Count() + 3;
                    if(User.Identity?.IsAuthenticated ?? false) {
                        colspan++;
                    }
                    <tr><td colspan="@colspan" class="text-center">No data available</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="d-flex align-items-center gap-2">
            <select id="pageSizeSelect" 
                    name="pageSize"
                    class="form-select" 
                    style="width: 70px;"
                    hx-get="@Url.Action("Index", "Items")"
                    hx-target="#itemsContainer"
                    hx-swap="innerHTML"
                    hx-include="[name='inventoryId'], [name='searchText'], [name='sortBy'], [name='sortOrder']"
                    hx-vals='js:{page: 1}'>
                <option value="10" selected="@(Model.Items.PageSize == 10)">10</option>
                <option value="20" selected="@(Model.Items.PageSize == 20)">20</option>
                <option value="50" selected="@(Model.Items.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.Items.PageSize == 100)">100</option>
            </select>
        </div>
        @if(Model.Items.TotalPages > 1) {
            <div class="d-flex gap-2 align-items-center">
                <button class="btn btn-secondary"
                        hx-get="@Url.Action("Index", "Items")"
                        hx-target="#itemsContainer"
                        hx-swap="innerHTML"
                        hx-include="[name='inventoryId'], [name='pageSize'], [name='searchText'], [name='sortBy'], [name='sortOrder']"
                        hx-vals='js:{page: @(Model.Items.PageIndex - 1)}'
                        @(Model.Items.PageIndex == 1 ? "disabled" : "")>
                    &lt;
                </button>
                <span class="px-2">
                    <strong>@Model.Items.PageIndex</strong> / @Model.Items.TotalPages
                </span>
                <button class="btn btn-secondary"
                        hx-get="@Url.Action("Index", "Items")"
                        hx-target="#itemsContainer"
                        hx-swap="innerHTML"
                        hx-include="[name='inventoryId'], [name='pageSize'], [name='searchText'], [name='sortBy'], [name='sortOrder']"
                        hx-vals='js:{page: @(Model.Items.PageIndex + 1)}'
                        @(Model.Items.PageIndex == Model.Items.TotalPages ? "disabled" : "")>
                    &gt;
                </button>
            </div>
        }
    </div>
</div>
<script>
    if (!document.querySelector('#selectAll')?.hasAttribute('data-initialized')) {
        const selectAllCheckbox = document.getElementById('selectAll');
        selectAllCheckbox?.addEventListener('change', function() {
            document.querySelectorAll('.item-select').forEach(cb => {
                cb.checked = selectAllCheckbox.checked;
            });
        });
    }

    function getSelectedId() {
        const selected = Array.from(document.querySelectorAll('.item-select:checked'))
            .map(cb => parseInt(cb.value));
    
        if (selected.length !== 1) {
            return null;
        }
    
        return selected[0];
    }

    function getSelectedIds() {
        return Array.from(document.querySelectorAll('.item-select:checked'))
            .map(cb => parseInt(cb.value));
    }
</script>