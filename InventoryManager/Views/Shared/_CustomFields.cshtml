@using InventoryManager.Models.ViewModels.Inventories
@model InventoryCustomFieldsViewModel

<form id="customFieldsForm" method="post" asp-action="UpdateCustomFields" asp-controller="Inventories">
    @Html.AntiForgeryToken()
    <div class="mt-3">
        <input type="hidden" name="InventoryId" value="@Model.InventoryId" />
        <span id="fieldsSaveIndicator" class="badge bg-secondary mb-3">Autosave enabled</span>
        <div id="fieldsContainer">
            @if(Model != null && Model.CustomFields.Any()) {
                @foreach(var field in Model.CustomFields.OrderBy(x => x.Order)) {
                    @await Html.PartialAsync("_CustomField", field)
                }
            }
        </div>
        <div class="mt-3">
            <button type="button" class="btn btn-primary" onclick="saveFields()" id="manualSaveBtn">
                Save
            </button>
            <div class="btn-group">
                <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">Add element</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="addField(0)">Single-line text</a></li>
                    <li><a class="dropdown-item" href="#" onclick="addField(1)">Multi-line text</a></li>
                    <li><a class="dropdown-item" href="#" onclick="addField(2)">Number</a></li>
                    <li><a class="dropdown-item" href="#" onclick="addField(3)">Link</a></li>
                    <li><a class="dropdown-item" href="#" onclick="addField(4)">Checkbox</a></li>
                </ul>
            </div>
        </div>
    </div>
</form>
